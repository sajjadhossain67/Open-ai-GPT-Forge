# OpenGPT Forge Environment Configuration
# Keep all API keys server-side. Never prefix secrets with VITE_.

# Default provider: deepseek | openai | anthropic | gemini | local
FORGE_DEFAULT_PROVIDER=deepseek

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Local LLM (Ollama, LM Studio, vLLM — OpenAI-compatible)
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5-coder:7b
LOCAL_LLM_API_KEY=

# Harness runtime settings
HOST=127.0.0.1
PORT=3080
FORGE_DATA_DIR=.forge-data
FORGE_WORKSPACE_ROOT=.
# Sandbox mode: read-only | workspace-write | danger-full-access
FORGE_SANDBOX_MODE=workspace-write
FORGE_MAX_STEPS=12
# Optional path to JSON file defining MCP stdio servers
FORGE_MCP_CONFIG=
LOG_LEVEL=info
